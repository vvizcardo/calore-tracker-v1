function calcResultHTML(){
  const p = S.settings.profile, wm = weightMap(), ds = Object.keys(wm).sort();
  const w = num($('#c-w') ? $('#c-w').value : '') ?? (ds.length ? wm[ds[ds.length - 1]] : null);
  const a = num(p.age), h = num(p.height);
  if (!w || !a || !h) return `<p class="note">Fill in age, height and weight to get an estimate.</p>`;
  const bmr = 10 * w + 6.25 * h - 5 * a + (p.sex === 'm' ? 5 : -161);
  const tdee = bmr * p.activity, target = Math.round((tdee + (+p.adj)) / 10) * 10;
  const prot = Math.round(w * p.pkg), fat = Math.round(target * .25 / 9), carbs = Math.max(0, Math.round((target - prot * 4 - fat * 9) / 4));
  SH.calc = {target, prot, fat, carbs};
  return `<div class="prev" style="display:block"><div class="big num">${fmt(target)} <small>kcal a day</small></div>
    <p style="margin:6px 0 0"><small>Maintenance about ${fmt(Math.round(tdee))} kcal · resting ${fmt(Math.round(bmr))} kcal</small></p>
    <p style="margin:2px 0 0"><small>Suggested: protein ${prot} g · fat ${fat} g · carbs ${carbs} g</small></p></div>
    <button class="btn pri block" data-act="useCalc">Use as my daily targets</button>
    <p class="note">This is an estimate (Mifflin-St Jeor). Watch your weight trend for a few weeks and adjust.</p>`;
}
