<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Fuel">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#f5f5f2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e0e0e" media="(prefers-color-scheme: dark)">
<title>Fuel</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" defer></script>
<style>
:root{
  --paper:#f5f5f2; --panel:#ffffff; --ink:#000000; --muted:#66665f; --hair:#d2d2ca;
  --accent:#1f3fff; --warn:#e08a00; --over:#d42a1f; --under:#a9a9a0;
}
@media (prefers-color-scheme: dark){
  :root{ --paper:#0e0e0e; --panel:#171717; --ink:#f4f4f0; --muted:#9b9b93; --hair:#333330;
         --accent:#7189ff; --warn:#f2b233; --over:#ff5b4d; --under:#585852; }
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;min-height:100%}
body{
  font:15px/1.35 'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;
  background:var(--paper);color:var(--ink);-webkit-text-size-adjust:100%;
  font-variant-numeric:tabular-nums;
}
body.lock{overflow:hidden}
button{font:inherit;color:inherit;cursor:pointer}
input,select{font:inherit;font-size:16px;color:var(--ink);background:var(--panel);border:2px solid var(--ink);border-radius:0;padding:9px 10px;width:100%;min-width:0;appearance:none;-webkit-appearance:none}
select{background-image:linear-gradient(45deg,transparent 50%,var(--ink) 50%),linear-gradient(135deg,var(--ink) 50%,transparent 50%);background-position:calc(100% - 17px) 55%,calc(100% - 12px) 55%;background-size:5px 5px;background-repeat:no-repeat;padding-right:30px}
input:focus-visible,select:focus-visible,button:focus-visible{outline:3px solid var(--accent);outline-offset:1px}
label.f{display:block;font-weight:700;font-size:13px;margin:12px 0 4px}
.muted{color:var(--muted)}
.num{font-variant-numeric:tabular-nums;font-weight:700}

#view{max-width:560px;margin:0 auto;padding:calc(env(safe-area-inset-top,0px) + 12px) 14px calc(150px + env(safe-area-inset-bottom,0px))}
h1{font-size:30px;line-height:1.05;font-weight:800;letter-spacing:-.02em;margin:6px 0 12px}
h2{font-size:21px;font-weight:800;letter-spacing:-.01em;margin:26px 0 8px}
h3{font-size:15px;font-weight:800;margin:0}
p{margin:6px 0}
.empty{color:var(--muted);padding:14px 0}

/* tabs */
#tabs{position:fixed;left:0;right:0;bottom:0;z-index:20;display:grid;grid-template-columns:repeat(5,1fr);background:var(--paper);border-top:2px solid var(--ink);padding-bottom:env(safe-area-inset-bottom,0px)}
#tabs button{background:none;border:0;border-top:5px solid transparent;margin-top:-2px;padding:8px 0 9px;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:11px;font-weight:700;color:var(--muted)}
#tabs button svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:square}
#tabs button.on{color:var(--ink);border-top-color:var(--accent)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:2px solid var(--ink);background:var(--panel);color:var(--ink);padding:10px 14px;font-weight:800;border-radius:2px}
.btn.pri{background:var(--ink);color:var(--paper)}
.btn.danger{border-color:var(--over);color:var(--over)}
.btn.block{display:flex;width:100%}
.btn.sm{padding:6px 10px;font-size:13px}
.row2{display:flex;gap:8px}
.row2>*{flex:1}
.fab{position:fixed;z-index:15;left:50%;transform:translateX(-50%);bottom:calc(74px + env(safe-area-inset-bottom,0px));padding:14px 26px;font-size:16px;box-shadow:0 0 0 4px var(--paper)}

/* date header */
.datebar{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.datebar .arr{border:2px solid var(--ink);background:var(--panel);width:44px;height:44px;font-size:20px;font-weight:800;border-radius:2px;flex:none}
.datebar .dt{position:relative;flex:1;min-width:0}
.datebar .dt h1{margin:0}
.datebar .dt input{position:absolute;inset:0;opacity:0;width:100%;height:100%;border:0;padding:0}
.datebar small{display:block;color:var(--muted);font-weight:700}

/* nutrition label panel */
.label{background:var(--panel);border:2px solid var(--ink);padding:12px 14px 6px}
.l-cal{display:flex;justify-content:space-between;align-items:flex-end;gap:10px}
.l-cal .k{font-size:22px;font-weight:800}
.l-cal .v{font-size:60px;line-height:.9;font-weight:800;font-stretch:82%;letter-spacing:-.03em}
.l-sub{display:flex;justify-content:space-between;font-weight:700;margin:6px 0 10px}
.rule{border:0;border-top:8px solid var(--ink);margin:10px 0 0}
.bar{height:7px;background:var(--hair);position:relative;overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent)}
.bar.warn i{background:var(--warn)}
.bar.over i{background:var(--over)}
.bar.big{height:16px}
.nr{display:grid;grid-template-columns:1fr auto 44px;gap:0 8px;align-items:baseline;padding:7px 0 7px;border-top:1px solid var(--hair)}
.nr .nn{font-weight:800}
.nr.sub .nn{font-weight:500;padding-left:16px}
.nr .nv{font-weight:600;text-align:right}
.nr .of{color:var(--muted);font-weight:500}
.nr .np{text-align:right;font-weight:800}
.nr .bar{grid-column:1/-1;margin-top:5px;height:5px}
hr.rule + .nr{border-top:0}

/* lists */
.item{display:flex;justify-content:space-between;align-items:center;gap:12px;width:100%;text-align:left;background:none;border:0;border-top:1px solid var(--hair);padding:11px 0}
.item:first-child{border-top:0}
.item .l{min-width:0}
.item .l b{display:block;font-weight:800;overflow:hidden;text-overflow:ellipsis}
.item .l small{color:var(--muted);font-weight:600}
.item .r{text-align:right;flex:none;font-weight:800}
.item .r small{display:block;color:var(--muted);font-weight:600}
.grp{display:flex;justify-content:space-between;background:var(--ink);color:var(--paper);padding:6px 10px;font-weight:800;margin-top:10px}
.gbody{border-left:4px solid var(--ink);padding-left:10px}
.list-h{display:flex;justify-content:space-between;align-items:baseline}

/* segmented */
.seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;border:2px solid var(--ink);margin:0 0 10px}
.seg button{background:var(--panel);border:0;padding:9px 6px;font-weight:800}
.seg button+button{border-left:2px solid var(--ink)}
.seg button.on{background:var(--ink);color:var(--paper)}

/* sheet */
.sheet-wrap{position:fixed;inset:0;z-index:50;display:flex;justify-content:center;align-items:flex-end}
.sheet-wrap[hidden]{display:none}
.scrim{position:absolute;inset:0;background:rgba(0,0,0,.5)}
.sheet{position:relative;background:var(--paper);width:100%;max-width:560px;max-height:92%;overflow:auto;border-top:5px solid var(--ink);padding:14px 14px calc(22px + env(safe-area-inset-bottom,0px));animation:up .18s ease-out;-webkit-overflow-scrolling:touch}
@keyframes up{from{transform:translateY(24px);opacity:.4}to{transform:none;opacity:1}}
@media (prefers-reduced-motion:reduce){.sheet{animation:none}}
.sh-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.sh-head h2{margin:0}
.x{background:none;border:0;font-weight:800;text-decoration:underline;padding:8px 0 8px 8px}

/* forms */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px 10px}
.fld{display:block}
.fld span{display:block;font-size:12px;font-weight:700;margin-bottom:3px}
.fld em{font-style:normal;color:var(--muted);font-weight:600}
.urow{display:grid;grid-template-columns:1fr auto 90px auto auto;gap:6px;align-items:center;margin-bottom:6px}
.urow .eq{font-weight:800}
.prev{border:2px solid var(--ink);background:var(--panel);padding:10px 12px;margin:12px 0;display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.prev .big{font-size:34px;font-weight:800;font-stretch:82%;line-height:1}
.prev small{font-weight:700;color:var(--muted)}

/* chart */
.chart-wrap{background:var(--panel);border:2px solid var(--ink);padding:8px 6px 6px}
svg.chart{width:100%;height:auto;display:block;touch-action:pan-y;user-select:none}
svg.chart text{font-family:inherit;font-size:9.5px;fill:var(--muted);font-weight:600}
.b-hit{fill:var(--accent)} .b-over{fill:var(--warn)} .b-way-over{fill:var(--over)} .b-under{fill:var(--under)} .b-way-under{fill:var(--under)}
.b-way-under{opacity:.55}
.read{min-height:40px;padding:6px 8px 2px;font-weight:700}
.legend{display:flex;flex-wrap:wrap;gap:4px 14px;padding:4px 8px 6px;font-size:12px;font-weight:700;color:var(--muted)}
.legend i{display:inline-block;width:11px;height:11px;margin-right:5px;vertical-align:-1px}
.legend i.ln{height:0;border-top:3px solid var(--ink);vertical-align:3px;width:16px}
.legend i.dash{height:0;border-top:2px dashed var(--accent);vertical-align:3px;width:16px}

/* week */
.strip{position:relative;display:grid;grid-template-columns:repeat(7,1fr);gap:6px;align-items:end;background:var(--panel);border:2px solid var(--ink);padding:14px 8px 8px}
.dcol .track{position:relative}
.dcol .track.tgt::after{content:'';position:absolute;left:-4px;right:-4px;bottom:71.43%;border-top:2px dashed var(--accent);pointer-events:none}
.dcol{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:11px;font-weight:700}
.dcol .track{height:96px;width:100%;display:flex;align-items:flex-end}
.dcol .db{width:100%;background:var(--hair)}
.dcol .db.hit{background:var(--accent)} .dcol .db.over{background:var(--warn)} .dcol .db.way-over{background:var(--over)} .dcol .db.under{background:var(--under)} .dcol .db.way-under{background:var(--under);opacity:.55}
.dcol .d{font-weight:800;font-size:13px}
.dcol .k{color:var(--muted);font-size:10px}
.sr{display:flex;justify-content:space-between;gap:12px;border-top:1px solid var(--hair);padding:9px 0}
.sr:first-child{border-top:0}
.sr b{font-weight:800}
.sr .v{text-align:right;font-weight:700}
.sr .v small{display:block;color:var(--muted);font-weight:600}
.panel{background:var(--panel);border:2px solid var(--ink);padding:4px 14px}
.hero{background:var(--panel);border:2px solid var(--ink);padding:12px 14px;margin-bottom:10px}
.hero .v{font-size:56px;line-height:.9;font-weight:800;font-stretch:82%;letter-spacing:-.03em}
.hero .s{font-weight:700;margin-top:6px}
.good{color:var(--accent)} .bad{color:var(--over)} .amber{color:var(--warn)}
.note{font-size:13px;color:var(--muted);font-weight:600;margin:8px 0}
details{border:2px solid var(--ink);background:var(--panel);margin:10px 0}
details>summary{padding:12px 14px;font-weight:800;cursor:pointer;list-style:none}
details>summary::-webkit-details-marker{display:none}
details>summary::after{content:'+';float:right;font-weight:800}
details[open]>summary::after{content:'–'}
details .in{padding:2px 14px 14px}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(130px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--paper);padding:10px 16px;font-weight:800;z-index:80;opacity:0;pointer-events:none;transition:opacity .15s}
#toast.on{opacity:1}
</style>
</head>
<body>
<main id="view"></main>
<nav id="tabs" aria-label="Sections"></nav>
<div id="sheetwrap" class="sheet-wrap" hidden>
  <div class="scrim" data-act="close"></div>
  <div class="sheet" id="sheet" role="dialog" aria-modal="true"></div>
</div>
<div id="toast" role="status"></div>

<script>
'use strict';
/* ============================================================
   Fuel — personal calorie & weight tracker
   Everything is stored in this browser (localStorage). No accounts, no servers.
   ============================================================ */
const KEY = 'fuel.v1';
const DAYN = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const MONN = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

/* t: 'goal' = try to reach it, 'limit' = try to stay under it */
const NUTS = [
  {k:'kcal',n:'Calories',u:'kcal',t:'goal',dp:0},
  {k:'protein',n:'Protein',u:'g',t:'goal',dp:1},
  {k:'carbs',n:'Carbohydrates',u:'g',t:'goal',dp:1},
  {k:'sugar',n:'Sugars',u:'g',t:'limit',dp:1,sub:1},
  {k:'fiber',n:'Fiber',u:'g',t:'goal',dp:1,sub:1},
  {k:'fat',n:'Total fat',u:'g',t:'goal',dp:1},
  {k:'sat',n:'Saturated fat',u:'g',t:'limit',dp:1,sub:1},
  {k:'trans',n:'Trans fat',u:'g',t:'limit',dp:1,sub:1},
  {k:'chol',n:'Cholesterol',u:'mg',t:'limit',dp:0},
  {k:'sodium',n:'Sodium',u:'mg',t:'limit',dp:0},
  {k:'potassium',n:'Potassium',u:'mg',t:'goal',dp:0},
  {k:'calcium',n:'Calcium',u:'mg',t:'goal',dp:0},
  {k:'iron',n:'Iron',u:'mg',t:'goal',dp:1},
  {k:'vitd',n:'Vitamin D',u:'mcg',t:'goal',dp:1}
];
const NK = Object.fromEntries(NUTS.map(n => [n.k, n]));

const DEFAULTS = () => ({
  targets:{kcal:2000,protein:120,carbs:250,fat:65,sat:20,fiber:30,sugar:50,sodium:2300},
  band:{lo:.9,hi:1.05,big:.25},
  profile:{sex:'m',age:'',height:'',activity:1.55,adj:-500,pkg:1.8}
});

/* ---------- helpers ---------- */
const $ = s => document.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const pad = n => String(n).padStart(2, '0');
const ymd = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const today = () => ymd(new Date());
const parseYmd = s => { const [y,m,d] = s.split('-').map(Number); return new Date(y, m-1, d); };
const addDays = (s, n) => { const d = parseYmd(s); d.setDate(d.getDate() + n); return ymd(d); };
const nowTime = () => { const d = new Date(); return pad(d.getHours()) + ':' + pad(d.getMinutes()); };
const dl = s => { const d = parseYmd(s); return `${DAYN[d.getDay()]} ${d.getDate()} ${MONN[d.getMonth()]}`; };
const dshort = s => { const d = parseYmd(s); return `${d.getDate()} ${MONN[d.getMonth()]}`; };
const mondayOf = s => addDays(s, -((parseYmd(s).getDay() + 6) % 7));
const fmt = (v, dp = 0) => Number(v).toLocaleString('en-US', {maximumFractionDigits: dp, minimumFractionDigits: 0});
const num = v => { const x = parseFloat(String(v ?? '').replace(',', '.')); return isNaN(x) ? null : x; };
const clone = o => JSON.parse(JSON.stringify(o));
const zero = () => { const t = {}; NUTS.forEach(n => t[n.k] = 0); return t; };
const sum = a => a.reduce((x, y) => x + y, 0);
const signed = (v, dp = 0) => (v > 0 ? '+' : v < 0 ? '−' : '') + fmt(Math.abs(v), dp);
const nfmt = (k, v) => fmt(v, NK[k].dp);

/* ---------- storage ---------- */
let S = load();
let TM = null, WM = null;
function fresh(){ return {v:1, foods:[], meals:[], log:[], weights:[], settings:DEFAULTS()}; }
function load(){
  try {
    const raw = localStorage.getItem(KEY);
    if (raw) return normalize(JSON.parse(raw));
  } catch (e) {}
  return fresh();
}
function normalize(d){
  const f = fresh();
  d = d || {};
  f.foods = Array.isArray(d.foods) ? d.foods : [];
  f.meals = Array.isArray(d.meals) ? d.meals : [];
  f.log = Array.isArray(d.log) ? d.log : [];
  f.weights = Array.isArray(d.weights) ? d.weights : [];
  const s = d.settings || {};
  f.settings.targets = s.targets ? s.targets : f.settings.targets;
  f.settings.band = Object.assign(f.settings.band, s.band || {});
  f.settings.profile = Object.assign(f.settings.profile, s.profile || {});
  return f;
}
function save(){
  TM = null; WM = null;
  try { localStorage.setItem(KEY, JSON.stringify(S)); }
  catch (e) { toast('Could not save. Browser storage may be full or blocked.'); }
}
try { if (navigator.storage && navigator.storage.persist) navigator.storage.persist(); } catch (e) {}

/* ---------- data helpers ---------- */
const food = id => S.foods.find(f => f.id === id);
const meal = id => S.meals.find(m => m.id === id);

function unitAmt(f, unit){
  if (unit === f.per.unit) return 1;
  const u = (f.units || []).find(u => u.name === unit);
  return u ? +u.amt : 1;
}
function unitsOf(f){
  const out = [f.per.unit];
  (f.units || []).forEach(u => { if (!out.includes(u.name)) out.push(u.name); });
  return out;
}
function calc(f, qty, unit){
  const k = qty * unitAmt(f, unit) / (f.per.amt || 1);
  const n = {};
  NUTS.forEach(x => n[x.k] = +(((+f.n[x.k] || 0) * k).toFixed(2)));
  return n;
}
function defQty(f){
  if (f.last && unitsOf(f).includes(f.last.unit)) return f.last.qty;
  return ['g','ml'].includes(f.per.unit) ? f.per.amt : 1;
}
function defUnit(f){ return f.last && unitsOf(f).includes(f.last.unit) ? f.last.unit : f.per.unit; }
function mealNut(m){
  const t = zero();
  (m.items || []).forEach(it => {
    const f = food(it.foodId); if (!f) return;
    const n = calc(f, it.qty, it.unit);
    NUTS.forEach(x => t[x.k] += n[x.k]);
  });
  NUTS.forEach(x => t[x.k] /= (m.servings || 1));
  return t;
}
function totalsMap(){
  if (TM) return TM;
  TM = {};
  S.log.forEach(e => {
    const t = TM[e.date] || (TM[e.date] = zero());
    NUTS.forEach(n => t[n.k] += +e.n[n.k] || 0);
  });
  return TM;
}
function weightMap(){
  if (WM) return WM;
  const acc = {};
  S.weights.forEach(w => (acc[w.date] || (acc[w.date] = [])).push(+w.kg));
  WM = {};
  Object.keys(acc).forEach(d => WM[d] = sum(acc[d]) / acc[d].length);
  return WM;
}
function status(kcal, target){
  if (!kcal || !target) return 'none';
  const r = kcal / target, b = S.settings.band;
  if (r >= 1 + b.big) return 'way-over';
  if (r <= 1 - b.big) return 'way-under';
  if (r > b.hi) return 'over';
  if (r < b.lo) return 'under';
  return 'hit';
}

/* ---------- UI state ---------- */
const ST = {tab:'today', date:today(), follow:true, range:30, weekStart:mondayOf(today()), fseg:'foods', fq:''};
let SH = {};      // sheet state
let DR = null;    // draft (meal editor)
let CH = null;    // chart geometry

function toast(msg){
  const t = $('#toast'); t.textContent = msg; t.classList.add('on');
  clearTimeout(toast._t); toast._t = setTimeout(() => t.classList.remove('on'), 1900);
}

/* ---------- icons + tabs ---------- */
const ICON = {
  today:'<rect x="5" y="3" width="14" height="18"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  foods:'<path d="M4 11h16a8 8 0 0 1-16 0z"/><path d="M8 7c0-2 2-3 4-3"/>',
  weight:'<path d="M3 17l5-6 4 3 8-9"/><path d="M3 21h18"/>',
  week:'<rect x="4" y="5" width="16" height="15"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  more:'<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>'
};
const TABS = [['today','Today'],['foods','Foods'],['weight','Weight'],['week','Week'],['more','More']];
function renderTabs(){
  $('#tabs').innerHTML = TABS.map(([k, n]) =>
    `<button data-act="tab" data-t="${k}" class="${ST.tab === k ? 'on' : ''}" aria-label="${n}"><svg viewBox="0 0 24 24">${ICON[k]}</svg>${n}</button>`).join('');
}

/* ============================================================
   TODAY
   ============================================================ */
function nrow(n, v, t){
  const pct = t ? v / t : null;
  let c = '';
  if (t && n.t === 'limit') c = pct > 1 ? 'over' : pct > .85 ? 'warn' : '';
  return `<div class="nr ${n.sub ? 'sub' : ''}">
    <div class="nn">${n.n}</div>
    <div class="nv num">${nfmt(n.k, v)} ${n.u}${t ? ` <span class="of">/ ${fmt(t, n.dp)}</span>` : ''}</div>
    <div class="np num">${t ? Math.round(pct * 100) + '%' : ''}</div>
    ${t ? `<div class="bar ${c}"><i style="width:${Math.min(100, pct * 100)}%"></i></div>` : ''}
  </div>`;
}
function entryRow(e){
  const f = e.n;
  return `<button class="item" data-act="editEntry" data-id="${e.id}">
    <span class="l"><b>${esc(e.name)}</b><small>${e.brand ? esc(e.brand) + ' · ' : ''}${fmt(e.qty, 2)} ${esc(e.unit)} · ${esc(e.time || '')}</small></span>
