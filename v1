/* ============================================================
   RENDER
   ============================================================ */
const VIEWS = {today:viewToday, foods:viewFoods, weight:viewWeight, week:viewWeek, more:viewMore};
function render(top){
  renderTabs();
  const y = window.scrollY;
  $('#view').innerHTML = VIEWS[ST.tab]();
  window.scrollTo(0, top ? 0 : y);
  if (ST.tab === 'weight') bindChart();
}
function bindChart(){
  const svg = $('#chart'); if (!svg) return;
  const move = ev => {
    const r = svg.getBoundingClientRect();
    const px = (ev.clientX - r.left) / r.width * CH.W;
    const i = Math.max(0, Math.min(CH.range - 1, Math.floor((px - CH.L) / CH.bw)));
    const g = $('#guide'), gx = CH.x(i);
    g.setAttribute('x1', gx); g.setAttribute('x2', gx); g.style.display = '';
    $('#chart-read').innerHTML = chartRead(i);
  };
  svg.addEventListener('pointerdown', move);
  svg.addEventListener('pointermove', ev => { if (ev.buttons || ev.pointerType === 'touch') move(ev); });
}

/* ============================================================
   ACTIONS
   ============================================================ */
const A = {};
A.tab = el => { ST.tab = el.dataset.t; render(true); };
A.close = () => closeSheet();
A.dayShift = el => { ST.date = addDays(ST.date, +el.dataset.n); ST.follow = ST.date === today(); render(); };
A.goToday = () => { ST.date = today(); ST.follow = true; render(); };
A.weekShift = el => { ST.weekStart = addDays(ST.weekStart, 7 * +el.dataset.n); render(); };
A.weekNow = () => { ST.weekStart = mondayOf(today()); render(); };
A.range = el => { ST.range = +el.dataset.v; render(); };
A.fseg = el => { ST.fseg = el.dataset.s; ST.fq = ''; render(); };

/* log flow */
A.openLog = () => openLog();
A.logMode = el => { SH.mode = el.dataset.m; SH.q = ''; showSheet(logListHTML()); };
A.logFood = el => showSheet(logFoodHTML(el.dataset.id));
A.logMeal = el => showSheet(logMealHTML(el.dataset.id));
A.logBack = () => { SH = {mode: SH.mid ? 'meals' : 'foods', q: ''}; showSheet(logListHTML()); };
A.addFood = () => {
  const f = food(SH.fid); if (!f) return;
  const qty = num($('#lq').value), unit = $('#lu').value;
  if (!qty || qty <= 0) return toast('Enter an amount');
  const date = $('#ld').value || ST.date, time = $('#lt').value || nowTime();
  S.log.push({id:uid(), date, time, foodId:f.id, name:f.name, brand:f.brand || '', qty, unit, n:calc(f, qty, unit)});
  f.last = {qty, unit};
  save(); ST.date = date; ST.follow = date === today(); closeSheet(); render(); toast('Added to log');
};
A.addMeal = () => {
  const m = meal(SH.mid); if (!m) return;
  const q = num($('#mq').value);
  if (!q || q <= 0) return toast('Enter servings');
  const date = $('#ld').value || ST.date, time = $('#lt').value || nowTime(), gid = uid(), k = q / (m.servings || 1);
  let added = 0;
  (m.items || []).forEach(it => {
    const f = food(it.foodId); if (!f) return;
    const qty = +(it.qty * k).toFixed(3);
    S.log.push({id:uid(), gid, group:m.name, date, time, foodId:f.id, name:f.name, brand:f.brand || '', qty, unit:it.unit, n:calc(f, qty, it.unit)});
    added++;
  });
  if (!added) return toast('This meal has no valid ingredients');
  save(); ST.date = date; ST.follow = date === today(); closeSheet(); render(); toast('Meal added');
};

/* entries */
A.editEntry = el => { const e = S.log.find(x => x.id === el.dataset.id); if (e) showSheet(entryFormHTML(e)); };
A.saveEntry = el => {
  const e = S.log.find(x => x.id === el.dataset.id); if (!e) return;
  const qty = num($('#eq').value); if (!qty || qty <= 0) return toast('Enter an amount');
  const n = entryPreview(e);
  e.n = n; e.qty = qty; if (food(e.foodId)) e.unit = $('#eu').value;
  e.date = $('#ed').value || e.date; e.time = $('#et').value || e.time;
  save(); closeSheet(); render(); toast('Saved');
};
A.delEntry = el => {
  if (!confirm('Delete this entry?')) return;
  S.log = S.log.filter(x => x.id !== el.dataset.id); save(); closeSheet(); render(); toast('Deleted');
};

/* foods */
A.newFood = el => { SH = {from: el.dataset.from}; showSheet(foodFormHTML(null)); };
A.editFood = el => { const f = food(el.dataset.id); if (f) { SH = {from:'tab'}; showSheet(foodFormHTML(f)); } };
A.dupFood = el => { const f = food(el.dataset.id); if (f) { const c = clone(f); c.id = null; c.last = null; showSheet(foodFormHTML(c, true)); } };
A.addUnit = () => { $('#units').insertAdjacentHTML('beforeend', unitRowHTML({}, $('#f-unit').value)); };
A.rmUnit = el => el.closest('.urow').remove();
A.saveFood = el => {
  const name = $('#f-name').value.trim(), per = num($('#f-per').value), unit = $('#f-unit').value.trim();
  if (!name) return toast('Give the food a name');
  if (!per || per <= 0 || !unit) return toast('Set what the label values are per, e.g. 100 g');
  const n = {}; document.querySelectorAll('#sheet [data-n]').forEach(i => n[i.dataset.n] = num(i.value) ?? 0);
  const units = [];
  document.querySelectorAll('#units .urow').forEach(r => {
    const nm = r.querySelector('.u-name').value.trim(), am = num(r.querySelector('.u-amt').value);
    if (nm && am > 0 && nm !== unit && !units.some(u => u.name === nm)) units.push({name:nm, amt:am});
  });
  const id = el.dataset.id;
  if (id) {
    const f = food(id);
    Object.assign(f, {name, brand:$('#f-brand').value.trim(), per:{amt:per, unit}, n, units});
    if (f.last && !unitsOf(f).includes(f.last.unit)) f.last = null;
    save(); closeSheet(); render(); toast('Food saved');
  } else {
    const f = {id:uid(), name, brand:$('#f-brand').value.trim(), per:{amt:per, unit}, n, units};
    S.foods.push(f); save();
    if (SH.from === 'log') { SH = {}; showSheet(logFoodHTML(f.id)); render(); }
    else { closeSheet(); render(); toast('Food saved'); }
  }
};
A.delFood = el => {
  if (!confirm('Delete this food? Past log entries stay as they are.')) return;
  S.foods = S.foods.filter(f => f.id !== el.dataset.id); save(); closeSheet(); render(); toast('Deleted');
};

/* meals */
A.newMeal = () => { DR = {id:null, name:'', servings:1, items:[]}; showSheet(mealFormHTML()); };
A.editMeal = el => { const m = meal(el.dataset.id); if (m) { DR = clone(m); showSheet(mealFormHTML()); } };
A.mealAdd = () => { syncMeal(); showSheet(mealPickHTML()); };
A.mealBack = () => showSheet(mealFormHTML());
A.mealPickFood = el => {
  const f = food(el.dataset.id); if (!f) return;
  DR.items.push({foodId:f.id, name:f.name + (f.brand ? ' (' + f.brand + ')' : ''), qty:defQty(f), unit:defUnit(f)});
  showSheet(mealFormHTML());
};
A.mealRm = el => { syncMeal(); DR.items.splice(+el.dataset.i, 1); showSheet(mealFormHTML()); };
A.saveMeal = () => {
  syncMeal();
  if (!DR.name.trim()) return toast('Give the meal a name');
  if (!DR.items.length) return toast('Add at least one ingredient');
  const m = {id:DR.id || uid(), name:DR.name.trim(), servings:DR.servings || 1, items:DR.items.map(i => ({foodId:i.foodId, name:i.name, qty:i.qty, unit:i.unit}))};
  const i = S.meals.findIndex(x => x.id === m.id);
  if (i >= 0) S.meals[i] = m; else S.meals.push(m);
  save(); closeSheet(); render(); toast('Meal saved');
};
A.delMeal = el => {
  if (!confirm('Delete this meal? Past log entries stay as they are.')) return;
  S.meals = S.meals.filter(m => m.id !== el.dataset.id); save(); closeSheet(); render(); toast('Deleted');
};

/* weight */
A.addWeight = () => {
  const kg = num($('#w-kg').value); if (!kg || kg < 20 || kg > 400) return toast('Enter your weight in kg');
  S.weights.push({id:uid(), date:$('#w-date').value || today(), time:$('#w-time').value || nowTime(), kg, note:$('#w-note').value.trim()});
  save(); render(); toast('Weigh-in saved');
};
A.editWeight = el => { const w = S.weights.find(x => x.id === el.dataset.id); if (w) showSheet(weightFormHTML(w)); };
A.saveWeight = el => {
  const w = S.weights.find(x => x.id === el.dataset.id); if (!w) return;
  const kg = num($('#w-kg').value); if (!kg || kg < 20 || kg > 400) return toast('Enter your weight in kg');
  Object.assign(w, {kg, date:$('#w-date').value || w.date, time:$('#w-time').value, note:$('#w-note').value.trim()});
  save(); closeSheet(); render(); toast('Saved');
};
A.delWeight = el => {
  if (!confirm('Delete this weigh-in?')) return;
  S.weights = S.weights.filter(x => x.id !== el.dataset.id); save(); closeSheet(); render(); toast('Deleted');
};

/* more */
A.useCalc = () => {
  const c = SH.calc; if (!c) return;
  Object.assign(S.settings.targets, {kcal:c.target, protein:c.prot, fat:c.fat, carbs:c.carbs});
  save(); render(); toast('Targets updated');
};
function download(name, blob){
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name;
  document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1500);
}
A.exportJson = () => {
  download(`fuel-backup-${today()}.json`, new Blob([JSON.stringify(S, null, 1)], {type:'application/json'}));
  toast('Backup downloaded');
};
A.eraseAll = () => {
  if (!confirm('Erase ALL foods, meals, logs and weights on this device? This cannot be undone.')) return;
  if (!confirm('Really erase everything? Download a backup first if unsure.')) return;
  S = fresh(); save(); render(true); toast('All data erased');
};
A.exportXlsx = () => {
  let from = $('#ex-from').value, to = $('#ex-to').value;
  if (!from || !to) return toast('Pick both dates');
  if (from > to) [from, to] = [to, from];
  const tm = totalsMap(), T = S.settings.targets;
  const r2 = v => Math.round(v * 100) / 100;
  const nutHead = NUTS.filter(n => n.k !== 'kcal').map(n => `${n.n} (${n.u})`);
  const daily = [['Date', 'Weekday', 'Calories (kcal)', 'Calorie target', '% of target', 'Difference vs target', ...nutHead]];
  for (let d = from; d <= to; d = addDays(d, 1)) {
    const t = tm[d], wd = DAYN[parseYmd(d).getDay()];
    if (!t) { daily.push([d, wd, '', T.kcal ?? '', '', '', ...NUTS.slice(1).map(() => '')]); continue; }
    daily.push([d, wd, r2(t.kcal), T.kcal ?? '', T.kcal ? r2(t.kcal / T.kcal * 100) : '', T.kcal ? r2(t.kcal - T.kcal) : '', ...NUTS.slice(1).map(n => r2(t[n.k]))]);
  }
  const master = [['Date', 'Time', 'Meal', 'Food', 'Brand', 'Amount', 'Unit', 'Calories (kcal)', ...nutHead]];
  S.log.filter(e => e.date >= from && e.date <= to).sort((a, b) => (a.date + (a.time || '')).localeCompare(b.date + (b.time || '')))
    .forEach(e => master.push([e.date, e.time || '', e.group || '', e.name, e.brand || '', e.qty, e.unit, r2(e.n.kcal), ...NUTS.slice(1).map(n => r2(+e.n[n.k] || 0))]));
  const wts = [['Date', 'Time', 'Weight (kg)', 'Note']];
  S.weights.filter(w => w.date >= from && w.date <= to).sort((a, b) => (a.date + (a.time || '')).localeCompare(b.date + (b.time || '')))
    .forEach(w => wts.push([w.date, w.time || '', w.kg, w.note || '']));
  const base = `fuel_${from}_to_${to}`;
  if (window.XLSX) {
    const wb = XLSX.utils.book_new();
    [['Daily summary', daily, [12, 9, 15, 14, 11, 18]], ['Master log', master, [12, 7, 16, 26, 16, 9, 9, 15]], ['Weight', wts, [12, 7, 12, 30]]].forEach(([nm, rows, w]) => {
      const ws = XLSX.utils.aoa_to_sheet(rows); ws['!cols'] = rows[0].map((_, i) => ({wch: w[i] || 14})); XLSX.utils.book_append_sheet(wb, ws, nm);
    });
    XLSX.writeFile(wb, base + '.xlsx');
    toast('Excel file downloaded');
  } else {
    const csv = rows => rows.map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n');
    download(base + '_daily.csv', new Blob([csv(daily)], {type:'text/csv'}));
    setTimeout(() => download(base + '_master.csv', new Blob([csv(master)], {type:'text/csv'})), 400);
    toast('Excel library did not load, so two CSV files were saved instead');
  }
};

/* ---------- event wiring ---------- */
document.addEventListener('click', e => {
  const el = e.target.closest('[data-act]'); if (!el) return;
  const fn = A[el.dataset.act]; if (fn) fn(el, e);
});

const IN = {
  fq: t => { ST.fq = t.value; $('#flist').innerHTML = foodsListHTML(); },
  sheetQ: t => {
    SH.q = t.value;
    if (SH.mode === 'mealpick') $('#pick').innerHTML = filterFoods(SH.q).map(f => foodItemHTML(f, 'mealPickFood')).join('') || '<p class="empty">No foods match.</p>';
    else $('#pick').innerHTML = pickListHTML();
  },
  logPrev: () => {
    const f = food(SH.fid); if (!f) return;
    $('#prev').innerHTML = prevHTML(calc(f, num($('#lq').value) || 0, $('#lu').value));
  },
  mealPrev: () => {
    const m = meal(SH.mid); if (!m) return;
    const q = num($('#mq').value) || 0, n = mealNut(m), o = {};
    NUTS.forEach(x => o[x.k] = n[x.k] * q);
    $('#prev').innerHTML = prevHTML(o);
  },
  entryPrev: () => {
    const e = S.log.find(x => x.id === (document.querySelector('[data-act=saveEntry]') || {dataset:{}}).dataset.id);
    if (e) $('#prev').innerHTML = prevHTML(entryPreview(e));
  },
  perUnit: () => { document.querySelectorAll('.u-base').forEach(s => s.textContent = $('#f-unit').value); },
  mealDraft: () => { syncMeal(); if ($('#prev') && DR) $('#prev').innerHTML = prevHTML(mealNut(DR)); }
};
const onInput = e => { const k = e.target.dataset && e.target.dataset.inp; if (k && IN[k]) IN[k](e.target, e); };
document.addEventListener('input', onInput);
document.addEventListener('change', onInput);

const CG = {
  pickDate: t => { if (t.value) { ST.date = t.value; ST.follow = t.value === today(); render(); } },
  target: t => { const v = num(t.value); if (v == null || v < 0) delete S.settings.targets[t.dataset.k]; else S.settings.targets[t.dataset.k] = v; save(); toast('Saved'); },
  band: t => {
    const v = num(t.value); if (v == null || v < 0) return;
    S.settings.band[t.dataset.k] = v / 100; save(); toast('Saved');
  },
  prof: t => {
    const k = t.dataset.k;
    if (k === 'w') { $('#calc-out').innerHTML = calcResultHTML(); return; }
    S.settings.profile[k] = ['sex'].includes(k) ? t.value : (['age', 'height'].includes(k) ? t.value : num(t.value));
    save(); $('#calc-out').innerHTML = calcResultHTML();
  },
  importJson: t => {
    const f = t.files && t.files[0]; if (!f) return;
    const r = new FileReader();
    r.onload = () => {
      try {
        const d = JSON.parse(r.result);
        if (!d || !Array.isArray(d.foods) || !Array.isArray(d.log)) throw new Error('bad');
        if (!confirm(`Replace everything on this device with this backup? It has ${d.foods.length} foods and ${d.log.length} log entries.`)) return;
        S = normalize(d); save(); render(true); toast('Backup restored');
      } catch (err) { toast('That file is not a valid Fuel backup'); }
    };
    r.readAsText(f);
  }
};
document.addEventListener('change', e => { const k = e.target.dataset && e.target.dataset.chg; if (k && CG[k]) CG[k](e.target, e); });

/* roll over to the new day if the app was left open overnight */
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible' && ST.follow && ST.date !== today()) {
    ST.date = today(); ST.weekStart = mondayOf(today()); render();
  }
});

render(true);
</script>
</body>
</html>
