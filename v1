/* ============================================================
   WEIGHT TAB (trend chart)
   ============================================================ */
function chartHTML(range){
  const end = today(), start = addDays(end, -(range - 1));
  const tm = totalsMap(), wm = weightMap(), T = S.settings.targets;
  const W = 360, H = 240, L = 36, R = 38, Tp = 16, Bt = 26, pw = W - L - R, ph = H - Tp - Bt;
  const days = [...Array(range)].map((_, i) => addDays(start, i));
  const kc = days.map(d => tm[d] ? tm[d].kcal : 0);
  const wd = days.map(d => wm[d] ?? null);
  let kmax = Math.max(T.kcal || 0, ...kc) * 1.12;
  kmax = Math.max(500, Math.ceil(kmax / 500) * 500);
  const bw = pw / range, x = i => L + bw * i + bw / 2, yk = v => Tp + ph - (v / kmax) * ph;
  const wv = wd.filter(v => v != null);
  let wmin, wmax, yw = null;
  if (wv.length) {
    wmin = Math.min(...wv); wmax = Math.max(...wv);
    const p = Math.max(.5, (wmax - wmin) * .25);
    wmin = Math.floor((wmin - p) * 2) / 2; wmax = Math.ceil((wmax + p) * 2) / 2;
    yw = v => Tp + ph - ((v - wmin) / (wmax - wmin)) * ph;
  }
  const ma = days.map((_, i) => {
    if (wd[i] == null) return null;
    const vs = []; for (let j = Math.max(0, i - 6); j <= i; j++) if (wd[j] != null) vs.push(wd[j]);
    return sum(vs) / vs.length;
  });
  let s = `<svg id="chart" class="chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="Daily calories and body weight">`;
  [0, .5, 1].forEach(f => {
    const y = Tp + ph - f * ph;
    s += `<line x1="${L}" x2="${W - R}" y1="${y}" y2="${y}" stroke="var(--hair)" stroke-width="1"/>`;
    s += `<text x="${L - 5}" y="${y + 3}" text-anchor="end">${fmt(kmax * f)}</text>`;
  });
  s += `<text x="${L - 5}" y="9" text-anchor="end" style="font-weight:800">kcal</text>`;
  days.forEach((d, i) => {
    if (kc[i] > 0) {
      const st = status(kc[i], T.kcal) === 'none' ? 'hit' : status(kc[i], T.kcal);
      const y = yk(kc[i]);
      s += `<rect class="b-${st}" x="${(x(i) - bw * .36).toFixed(2)}" y="${y.toFixed(2)}" width="${(bw * .72).toFixed(2)}" height="${(Tp + ph - y).toFixed(2)}"/>`;
    }
  });
  if (T.kcal) s += `<line x1="${L}" x2="${W - R}" y1="${yk(T.kcal)}" y2="${yk(T.kcal)}" stroke="var(--accent)" stroke-width="1.6" stroke-dasharray="5 4"/>`;
  if (yw) {
    s += `<text x="${W - R + 5}" y="9" style="font-weight:800">kg</text>`;
    s += `<text x="${W - R + 5}" y="${yw(wmax) + 3}">${wmax}</text><text x="${W - R + 5}" y="${yw(wmin) + 3}">${wmin}</text>`;
    const pts = days.map((_, i) => ma[i] != null ? `${x(i).toFixed(1)},${yw(ma[i]).toFixed(1)}` : null).filter(Boolean);
    if (pts.length > 1) s += `<polyline points="${pts.join(' ')}" fill="none" stroke="var(--ink)" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>`;
    days.forEach((_, i) => { if (wd[i] != null) s += `<circle cx="${x(i).toFixed(1)}" cy="${yw(wd[i]).toFixed(1)}" r="${range > 60 ? 1.6 : 2.6}" fill="var(--panel)" stroke="var(--ink)" stroke-width="1.6"/>`; });
  }
  [[0, 'start'], [Math.floor((range - 1) / 2), 'middle'], [range - 1, 'end']].forEach(([i, a]) => {
    s += `<text x="${a === 'start' ? L : a === 'end' ? W - R : x(i)}" y="${H - 8}" text-anchor="${a}">${dshort(days[i])}</text>`;
  });
  s += `<line id="guide" x1="0" x2="0" y1="${Tp}" y2="${Tp + ph}" stroke="var(--ink)" stroke-width="1" style="display:none"/>`;
  s += `<rect x="${L}" y="${Tp}" width="${pw}" height="${ph}" fill="transparent"/></svg>`;
  CH = {days, kc, wd, ma, L, bw, W, range, x};
  return s;
}
function chartRead(i){
  const c = CH, T = S.settings.targets; if (!c) return '';
  const d = c.days[i], k = c.kc[i], w = c.wd[i];
  const kt = k > 0 ? `${fmt(k)} kcal${T.kcal ? ` (${Math.round(k / T.kcal * 100)}% of target)` : ''}` : 'nothing logged';
  const wt = w != null ? `${fmt(w, 1)} kg · 7-day avg ${fmt(c.ma[i], 1)} kg` : 'no weight';
  return `${dl(d)}: ${kt}<br><span class="muted">${wt}</span>`;
}
function wRowHTML(w){
  return `<button class="item" data-act="editWeight" data-id="${w.id}"><span class="l"><b class="num">${fmt(w.kg, 2)} kg</b><small>${esc(w.note || '')}</small></span><span class="r">${dl(w.date)}<small>${esc(w.time || '')}</small></span></button>`;
}
function viewWeight(){
  const wm = weightMap(), dates = Object.keys(wm).sort();
  const last = dates.length ? dates[dates.length - 1] : null;
  const end = today();
  const last7 = dates.filter(d => d > addDays(end, -7)).map(d => wm[d]);
  const rangeStart = addDays(end, -(ST.range - 1));
  const inR = dates.filter(d => d >= rangeStart);
  const chg = inR.length > 1 ? wm[inR[inR.length - 1]] - wm[inR[0]] : null;
  const ws = S.weights.slice().sort((a, b) => (b.date + (b.time || '')).localeCompare(a.date + (a.time || ''))).slice(0, 40);
  return `<h1>Weight</h1>
