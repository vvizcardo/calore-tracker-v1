/* ============================================================
   WEEK TAB
   ============================================================ */
function viewWeek(){
  const ws = ST.weekStart, tdy = today();
  const days = [...Array(7)].map((_, i) => addDays(ws, i));
  const tm = totalsMap(), T = S.settings.targets, B = S.settings.band, kt = T.kcal;
  const isNow = ws === mondayOf(tdy);
  const rows = days.map(d => ({d, t: tm[d] || null, future: d > tdy}));
  const logged = rows.filter(r => r.t && r.t.kcal > 0);
  const n = logged.length;
  const head_ = `<div class="datebar">
    <button class="arr" data-act="weekShift" data-n="-1" aria-label="Previous week">‹</button>
    <div class="dt"><h1>${isNow ? 'This week' : 'Week of ' + dshort(ws)}</h1><small>${dshort(ws)} to ${dshort(days[6])}</small></div>
    ${isNow ? '' : `<button class="btn sm" data-act="weekNow">Now</button>`}
    <button class="arr" data-act="weekShift" data-n="1" aria-label="Next week">›</button></div>`;
  if (!n) return head_ + `<p class="empty">Nothing logged this week yet. Once you log food, your weekly summary shows up here.</p>`;
  const tot = sum(logged.map(r => r.t.kcal)), avg = tot / n;
  const diff = kt ? avg - kt : null;
  const stat = r => status(r.t ? r.t.kcal : 0, kt);
  const hit = logged.filter(r => stat(r) === 'hit'), over = logged.filter(r => ['over', 'way-over'].includes(stat(r))),
        under = logged.filter(r => ['under', 'way-under'].includes(stat(r))),
        big = logged.filter(r => ['way-over', 'way-under'].includes(stat(r)));
  const maxKcal = Math.max(...logged.map(r => r.t.kcal));
  const strip = `<div class="strip">${rows.map(r => {
    const k = r.t ? r.t.kcal : 0, h = kt && k ? Math.min(1.4, k / kt) / 1.4 * 100 : (k ? Math.min(100, k / Math.max(maxKcal, 1) * 100) : 0);
    return `<div class="dcol"><div class="track ${kt ? 'tgt' : ''}"><div class="db ${kt ? stat(r) : 'hit'}" style="height:${h}%"></div></div><span class="d">${DAYN[parseYmd(r.d).getDay()].slice(0, 2)}</span><span class="k">${k ? fmt(k) : (r.future ? '' : '–')}</span></div>`;
  }).join('')}</div>`;
  const listDays = arr => arr.map(r => `${DAYN[parseYmd(r.d).getDay()]} ${parseYmd(r.d).getDate()}`).join(', ') || 'None';
  const sources = {};
  S.log.filter(e => e.date >= ws && e.date <= days[6]).forEach(e => sources[e.name] = (sources[e.name] || 0) + (+e.n.kcal || 0));
  const top = Object.entries(sources).sort((a, b) => b[1] - a[1]).slice(0, 3);
  const macroKcal = {p: sum(logged.map(r => r.t.protein)) * 4, c: sum(logged.map(r => r.t.carbs)) * 4, f: sum(logged.map(r => r.t.fat)) * 9};
  const mk = macroKcal.p + macroKcal.c + macroKcal.f || 1;
  const wm = weightMap();
  const wThis = days.filter(d => wm[d] != null).map(d => wm[d]);
  const prevDays = [...Array(7)].map((_, i) => addDays(ws, i - 7));
  const wPrev = prevDays.filter(d => wm[d] != null).map(d => wm[d]);
  const wAvg = wThis.length ? sum(wThis) / wThis.length : null, wPAvg = wPrev.length ? sum(wPrev) / wPrev.length : null;
  const balance = kt ? tot - kt * n : null;
  const worst = kt ? logged.slice().sort((a, b) => Math.abs(b.t.kcal - kt) - Math.abs(a.t.kcal - kt))[0] : null;
  const pT = T.protein, protHit = pT ? logged.filter(r => r.t.protein >= pT * .95) : [];
  const naT = T.sodium, naOver = naT ? logged.filter(r => r.t.sodium > naT) : [];
  const fibT = T.fiber;
  const dayLine = r => `${dl(r.d)}: ${fmt(r.t.kcal)} kcal (${signed((r.t.kcal / kt - 1) * 100)}%)`;
  return head_ + `
  <div class="hero"><div class="v num">${fmt(avg)}</div>
    <div class="s">kcal per day, average over ${n} logged ${n === 1 ? 'day' : 'days'}</div>
    ${kt ? `<div class="s ${Math.abs(diff) / kt <= (1 - B.lo) ? 'good' : diff > 0 ? 'bad' : 'amber'}">${signed(diff)} kcal a day vs target of ${fmt(kt)}</div>` : `<div class="note">Set a calorie target in More to see how you did against it.</div>`}</div>
  ${strip}
  <p class="note">Bars show each day against your target (dashed line). Blue = on target, orange = over, red = far over, grey = under.</p>
  ${kt ? `
  <h2>How the week went</h2>
  <div class="panel">
    <div class="sr"><b>On target</b><span class="v">${hit.length} of ${n} days<small>${fmt(B.lo * 100)}–${fmt(B.hi * 100)}% of target · ${listDays(hit)}</small></span></div>
    <div class="sr"><b>Over target</b><span class="v ${over.length ? 'amber' : ''}">${over.length} ${over.length === 1 ? 'day' : 'days'}<small>${listDays(over)}</small></span></div>
    <div class="sr"><b>Under target</b><span class="v">${under.length} ${under.length === 1 ? 'day' : 'days'}<small>${listDays(under)}</small></span></div>
    <div class="sr"><b>Big misses</b><span class="v ${big.length ? 'bad' : ''}">${big.length ? big.map(dayLine).join('<br>') : 'None'}<small>more than ${fmt(B.big * 100)}% off target</small></span></div>
    <div class="sr"><b>Biggest overeat</b><span class="v">${over.length ? (() => { const o = over.slice().sort((a, b) => b.t.kcal - a.t.kcal)[0]; return dl(o.d) + '<small>+' + fmt(o.t.kcal - kt) + ' kcal over target</small>'; })() : 'No overeating'}</span></div>
    <div class="sr"><b>Furthest from target</b><span class="v">${dl(worst.d)}<small>${fmt(worst.t.kcal)} kcal (${signed(worst.t.kcal - kt)})</small></span></div>
    <div class="sr"><b>Running balance</b><span class="v ${balance > 0 ? 'amber' : 'good'}">${signed(balance)} kcal<small>over ${n} logged days · roughly ${signed(balance / 7700, 2)} kg of body weight</small></span></div>
  </div>` : ''}
  <h2>Nutrition</h2>
  <div class="panel">
    <div class="sr"><b>Protein</b><span class="v">${fmt(sum(logged.map(r => r.t.protein)) / n)} g a day${pT ? `<small>hit target on ${protHit.length} of ${n} days</small>` : ''}</span></div>
    <div class="sr"><b>Macro split</b><span class="v">${Math.round(macroKcal.p / mk * 100)}% protein<small>${Math.round(macroKcal.c / mk * 100)}% carbs · ${Math.round(macroKcal.f / mk * 100)}% fat</small></span></div>
    <div class="sr"><b>Fiber</b><span class="v">${fmt(sum(logged.map(r => r.t.fiber)) / n, 1)} g a day${fibT ? `<small>target ${fmt(fibT)} g</small>` : ''}</span></div>
    <div class="sr"><b>Sodium</b><span class="v ${naOver.length ? 'amber' : ''}">${fmt(sum(logged.map(r => r.t.sodium)) / n)} mg a day${naT ? `<small>over the limit on ${naOver.length} of ${n} days</small>` : ''}</span></div>
    <div class="sr"><b>Top calorie sources</b><span class="v">${top.map(([nm, k]) => `${esc(nm)}<small>${fmt(k)} kcal · ${Math.round(k / tot * 100)}%</small>`).join('')}</span></div>
  </div>
  <h2>Weight</h2>
  <div class="panel">
    <div class="sr"><b>Average this week</b><span class="v">${wAvg != null ? fmt(wAvg, 1) + ' kg' : 'No weigh-ins'}</span></div>
    <div class="sr"><b>Versus previous week</b><span class="v ${wAvg != null && wPAvg != null ? (wAvg > wPAvg ? 'amber' : 'good') : ''}">${wAvg != null && wPAvg != null ? signed(wAvg - wPAvg, 2) + ' kg' : '—'}</span></div>
  </div>
  <p class="note">Days with nothing logged are left out of the averages. A day with only part of your food logged counts as under target.</p>`;
}

